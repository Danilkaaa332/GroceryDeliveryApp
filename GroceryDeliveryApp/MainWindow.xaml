<Window x:Class="GroceryDeliveryApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сервис доставки продуктов" Height="700" Width="1250"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <!--Заголовок "Каталог продуктов"-->
            <TextBlock Text="Каталог продуктов" FontSize="26" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center"/>
            <ScrollViewer Height="520" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <!--Список продуктов-->
                <ListBox x:Name="ProductsList" BorderThickness="0" SelectionMode="Single" Background="Transparent">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" Width="780"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <!--Шаблон карточки товара-->
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="230" Height="250" Margin="10" Padding="10" CornerRadius="15" BorderBrush="#CCCCCC" BorderThickness="1" Background="White">
                                <StackPanel>
                                    <Border Height="90" CornerRadius="10" Background="#B9E5C2">
                                        <TextBlock Text="Продукт" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20" FontWeight="Bold"/>
                                    </Border>
                                    <!--Название продукта-->
                                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" Margin="0,10,0,5"/>
                                    <!--Категория продукта-->
                                    <TextBlock Text="{Binding Category, StringFormat=Категория: {0}}" FontSize="14"/>
                                    <!--Цена продукта-->
                                    <TextBlock Text="{Binding Price, StringFormat=Цена: {0} P}" FontSize="16" FontWeight="Bold" Margin="0,5,0,5"/>
                                    <!--Количество продукта-->
                                    <TextBlock Text="{Binding Quantity, StringFormat=Количество: {0}}" FontSize="14"/>
                                    <!--Срок годности продукта-->
                                    <TextBlock Text="{Binding ExprirationDate, StringFormat=Годен до: {0:d}}" FontSize="13" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!--Кнопка "Добавить в корзину"-->
                <Button Grid.Column="0" Content="Добавить в корзину" Height="45" FontSize="20" Margin="5" Background="White" Click="AddToCart_Click"/>
                <!--Кнопка "Удалить продукт"-->
                <Button Grid.Column="1" Content="Удалить продукт" Height="45" FontSize="20" Margin="5" Background="White" Click="DeleteProduct_Click"/>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="20,0,10,0">
            <!--Заголовок "Корзина"-->
            <TextBlock Text="Корзина" FontSize="24" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>
            <!--Список товаров в корзине-->
            <ListBox x:Name="CartList" Height="180"/>
            <!--Строка с итоговой суммой-->
            <TextBlock x:Name="TotalPriceText" Text="Товары: 0 ₽ | Доставка: 250 ₽ | Итого: 250 ₽" FontSize="14" FontWeight="Bold" Margin="0,10,0,10"/>
            <!--Подпись поля ввода адреса-->
            <TextBlock Text="Введите адрес доставки" FontSize="16"/>
            <!--Поле ввода адреса доставки-->
            <TextBox x:Name="AddressTextBox" Height="35" FontSize="20" Margin="0,5,0,15"/>
            <!--Кнопка "Оформить заказ"-->
            <Button Content="Оформить заказ" Height="45" FontSize="20" Background="White" Click="CreateOrder_Click"/>
            <!--Заголовок "Список заказов"-->
            <TextBlock Text="Список заказов" FontSize="24" FontWeight="Bold" Margin="0,10,0,10" HorizontalAlignment="Center"/>
            <!--Список оформленных заказов-->
            <ListBox x:Name="OrdersList" Height="180"/>
        </StackPanel>
    </Grid>
</Window>